[Unit]
Description=CHUMA Control Plane State Check
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Environment=APP_ROOT=/opt/chuma
ExecStart=/opt/chuma/agent/chuma-control.sh status
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/chuma

[Install]
WantedBy=multi-user.target
