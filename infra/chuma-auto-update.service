[Unit]
Description=CHUMA Autonomous GitHub Update Agent
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Environment=APP_ROOT=/opt/chuma
Environment=CHUMA_UPDATE_INTERVAL=60
ExecStart=/opt/chuma/agent/auto-update.sh
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/chuma /etc/systemd/system

[Install]
WantedBy=multi-user.target
