{$CHUMA_DOMAIN} {
    encode gzip
    reverse_proxy {$CHUMA_UPSTREAM}

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    request_body {
        max_size 32MB
    }
}
