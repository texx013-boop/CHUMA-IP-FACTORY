{$CHUMA_DOMAIN} {
    encode gzip

    @control path /control/api/*
    handle @control {
        uri strip_prefix /control
        reverse_proxy unix//opt/chuma/control/control.sock
    }

    reverse_proxy {$CHUMA_UPSTREAM}

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    request_body {
        max_size 32MB
    }
}
