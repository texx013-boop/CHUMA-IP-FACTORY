[Unit]
Description=CHUMA Security Agent
After=network-online.target chuma-agent.service chuma-auto-update.service
Wants=network-online.target
Requires=chuma-agent.service

[Service]
Type=simple
User=root
Environment=APP_ROOT=/opt/chuma
Environment=CHUMA_SECURITY_INTERVAL=300
ExecStart=/opt/chuma/agent/chuma-security-agent.sh
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/chuma

[Install]
WantedBy=multi-user.target
