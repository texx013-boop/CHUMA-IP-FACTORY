# CHUMA Deployment Core
# Copy to .env and replace every secret before starting.

CHUMA_DOMAIN=chuma.example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=chuma
POSTGRES_USER=chuma
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
CHUMA_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_ADMIN_TOKEN

# Application policy
CHUMA_SPEND_MODE=free
CHUMA_ALLOW_PAID_GENERATION=false
CHUMA_MONTHLY_SOFT_CAP_USD=0
CHUMA_MONTHLY_HARD_CAP_USD=0

# Backup
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
