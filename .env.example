CHUMA_ADMIN_TOKEN=change-me
# DATABASE_URL=postgresql://...

# Budget policy: starts at $0 and never upgrades or charges automatically.
CHUMA_SPEND_MODE=free
CHUMA_ALLOW_PAID_GENERATION=false
CHUMA_MONTHLY_SOFT_CAP_USD=0
CHUMA_MONTHLY_HARD_CAP_USD=0

# Free AI image provider (Hugging Face routed Inference Providers; no subscription).
# HF_TOKEN=
CHUMA_HF_MODEL=black-forest-labs/FLUX.1-Krea-dev

# Optional metered external image provider (only used when explicitly permitted by the budget policy).
# CHUMA_IMAGE_ENDPOINT=
# CHUMA_IMAGE_API_KEY=
CHUMA_IMAGE_COST_CLASS=metered

CHUMA_HOST=0.0.0.0
CHUMA_DATA_DIR=/data
CHUMA_IMAGE_RETRY_ATTEMPTS=3
CHUMA_IMAGE_RETRY_DELAY=0.25
CHUMA_IMAGE_TIMEOUT=120
CHUMA_MEDIA_DIR=/data/media

# Optional real video renderer (provider-neutral HTTP adapter).
# CHUMA_VIDEO_ENDPOINT=
# CHUMA_VIDEO_API_KEY=
CHUMA_VIDEO_COST_CLASS=metered
CHUMA_VIDEO_RETRY_ATTEMPTS=2
CHUMA_VIDEO_RETRY_DELAY=1.0
CHUMA_VIDEO_TIMEOUT=300
